{
  "name": "gitlawb-sidecar",
  "version": "0.1.0",
  "description": "Add GitLawb as a signed second origin next to GitHub. Humans stay on GitHub; every push gets a verifiable certificate on the mesh.",
  "type": "module",
  "bin": {
    "gitlawb-sidecar": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "skills",
    "scripts",
    "action.yml",
    "README.md",
    "LICENSE",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc && find dist -name '*.test.*' -delete",
    "postinstall": "node scripts/install-skills.js",
    "test": "tsc && node --test dist/core/*.test.js",
    "test:live": "tsc && GITLAWB_LIVE=1 node --test dist/core/*.test.js",
    "sidecar": "node dist/cli.js"
  },
  "keywords": [
    "gitlawb",
    "github",
    "git",
    "agents",
    "claude-code",
    "cursor",
    "codex",
    "skill",
    "provenance",
    "did"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevOps21133/gitlawb-sidecar"
  },
  "homepage": "https://github.com/DevOps21133/gitlawb-sidecar",
  "dependencies": {
    "@gitlawb/gl": "0.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  }
}
